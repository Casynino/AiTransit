# ---------------------------------------------------------------------------
# Database — Neon PostgreSQL
# ---------------------------------------------------------------------------
# DATABASE_URL is the POOLED connection (…-pooler.…) used by the running app.
# DIRECT_URL is the DIRECT connection used by `prisma migrate` / `db push`.
# Both come from the Neon dashboard → Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/aitransit?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/aitransit?sslmode=require"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Only needed when the deployment URL is not auto-detected by Vercel.
# AUTH_URL="https://aitransit.vercel.app"

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Primary WhatsApp/phone shown across the public site. The named contacts, the
# Makeni warehouse address and the Guangzhou warehouse details live in
# lib/constants.ts (COMPANY) — edit them there.
NEXT_PUBLIC_COMPANY_PHONE="+260 96 5537047"
NEXT_PUBLIC_COMPANY_WHATSAPP="260965537047"
NEXT_PUBLIC_COMPANY_EMAIL="info@aitransit.co.zm"

# ---------------------------------------------------------------------------
# Cargo photo uploads (Vercel Blob). REQUIRED IN PRODUCTION.
#
# Photos are mandatory at receiving and at delivery. Without this token the app
# falls back to writing under public/uploads, which works on a laptop but NOT on
# Vercel — that filesystem is ephemeral, so every photo would be lost on the
# next deploy. The registration form warns when it is missing.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# ---------------------------------------------------------------------------
# Seed — the first CEO/Admin account. Change the password after first login.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@aitransit.co.zm"
SEED_ADMIN_PASSWORD="change-me-on-first-login"
